{
  "name": "orion-optimizer",
  "version": "2.1.2",
  "description": "ORION OPTIMIZER — análise de BIOS, otimização do Windows, game boost, limpeza e manutenção para Windows.",
  "main": "src/main.js",
  "author": "Orion",
  "license": "Proprietary",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win nsis --dir",
    "preview": "npx serve src/ui -p 3000 --no-clipboard",
    "styles:shadcn": "tailwindcss -i src/ui/shadcn.css -o src/ui/shadcn.dist.css --minify",
    "dev:app": "vite",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:version": "node scripts/release.js"
  },
  "devDependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.41.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.orion.optimizer",
    "productName": "ORION OPTIMIZER",
    "copyright": "Copyright © 2026 Orion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app/dist/**/*",
      "!src/engine/scripts/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "src/engine/scripts",
        "to": "engine/scripts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORION OPTIMIZER",
      "uninstallDisplayName": "ORION OPTIMIZER"
    }
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
