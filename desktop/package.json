{
  "name": "orion-optimizer",
  "version": "2.0.7",
  "description": "ORION OPTIMIZER — análise de BIOS, otimização do Windows, game boost, limpeza e manutenção para Windows.",
  "main": "src/main.js",
  "author": "Orion",
  "license": "Proprietary",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win nsis --dir",
    "preview": "npx serve src/ui -p 3000 --no-clipboard",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:version": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.orion.optimizer",
    "productName": "ORION OPTIMIZER",
    "copyright": "Copyright © 2026 Orion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/engine/scripts/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "src/engine/scripts",
        "to": "engine/scripts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORION OPTIMIZER",
      "uninstallDisplayName": "ORION OPTIMIZER"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
