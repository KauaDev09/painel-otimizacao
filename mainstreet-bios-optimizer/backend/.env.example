# Copie para .env e preencha. NUNCA comite o .env real.

# Porta da API
PORT=8787

# Segredo para assinar tokens HMAC (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Token mestre opcional de bootstrap do painel (deixe vazio se for usar login)
ADMIN_TOKEN=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=bios_app
DB_PASSWORD=senha-forte-aqui
DB_NAME=bios_optimizer

# CORS do painel (use * apenas em desenvolvimento)
CORS_ORIGIN=*

# Padrões ao gerar licenças
LICENSE_MAX_DEVICES=2
LICENSE_DAYS=365
