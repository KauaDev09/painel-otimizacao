# ORION OPTIMIZER — Backend (Vercel + TiDB Cloud)
# Copie este arquivo para .env em desenvolvimento e/ou preencha os mesmos
# valores nas Environment Variables do projeto na Vercel.
# NUNCA comite o arquivo .env.

# Segredo usado para assinar tokens HMAC (sessões de licença e admin).
# Gere um valor forte:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=byte_xa9fK2quR8T4vP7wM1nQzYcL6dHe3iJ

# ---- Banco de dados (TiDB Cloud Serverless - MySQL compatível) ----
# Em TiDB Serverless o HOST é algo como: gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_HOST=gateway01.xxxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxx.root
DB_PASSWORD=SUA_SENHA_DO_TIDB
DB_NAME=bios_optimizer

# ---- Painel administrativo ----
# Token mestre opcional para bootstrap (autenticação sem criar admin no banco).
# Preencha apenas se quiser acessar /api/v1/admin/* com Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=

# ---- Loja (Orion Store) ----
# URL pública da loja. Em desenvolvimento use http://localhost:3000
STORE_PUBLIC_URL=http://localhost:3000

# ---- SaaS (storefront/admin) ----
# URL pública base da aplicação (usada em links/e-mails e no webhook de retorno).
# Em dev: http://localhost:8787  |  Na Vercel: https://<seu-projeto>.vercel.app
APP_URL=http://localhost:8787

# Segredo compartilhado entre o desktop e a API para assinar a resposta de
# validação de licença (impede forjar o resultado no cliente).
# Gere:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_API_SECRET=

# ---- Pagamento (Mercado Pago) ----
# Deixe MERCADOPAGO_ACCESS_TOKEN vazio para o checkout retornar
# PAYMENT_NOT_CONFIGURED (modo de segurança até você cadastrar as credenciais).
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ---- CORS ----
# Origem permitida. "*" libera tudo (útil enquanto o desktop ainda usa o app).
CORS_ORIGIN=*

# ---- Licenças (padrões) ----
LICENSE_MAX_DEVICES=2
LICENSE_DAYS=365

# ---- Segurança (rate limiting) ----
# Número de requisições permitidas por janela de 60s por IP.
# Reduz brute-force de keys e abuso da API de licença/validação.
RATE_LIMIT_KEY=30
RATE_LIMIT_LICENSE=60
RATE_LIMIT_HISTORY=120

# ---- Porta (usado apenas em execução local com `npm start`) ----
PORT=8787
